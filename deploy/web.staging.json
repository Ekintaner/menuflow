{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "menuflow-web-staging",
  "main": "../worker/staging-web.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../.wrangler/pages-staging/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "MENUFLOW_API", "service": "menuflow-api-staging" }]
}
