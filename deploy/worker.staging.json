{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "menuflow-api-staging",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "vars": {
    "DEPLOYMENT_ENV": "staging",
    "ORDERING_DISABLED": "true"
  },
  "ratelimits": [
    {
      "name": "ORDER_LIMIT",
      "namespace_id": "4003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "4001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "MENU_LIMIT",
      "namespace_id": "4002",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ]
}
