{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "menuflow-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "dev": { "ip": "127.0.0.1", "port": 8798 },
  "observability": { "enabled": false },
  "ratelimits": [
    { "name": "ORDER_LIMIT", "namespace_id": "3003", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_LIMIT", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
    { "name": "MENU_LIMIT", "namespace_id": "3002", "simple": { "limit": 300, "period": 60 } }
  ]
}
